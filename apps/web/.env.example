# Copy to .env.local and fill in.
# NODE_ENV=production + `next start` validates these at server start
# (see src/lib/env.ts): the app refuses to serve with a missing Clerk key or
# API URL instead of failing silently per request.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Origin only (no trailing path/slash). https:// is enforced in production.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public canonical origin (no trailing slash) used by metadata, robots.txt and
# sitemap.xml. Defaults to http://localhost:3000 when unset.
#NEXT_PUBLIC_SITE_URL=https://ai-academy.example.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Optional observability (leave empty to disable Sentry).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
