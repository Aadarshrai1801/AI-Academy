# npm network resilience.
#
# Why this exists: a cold install of ~1000 packages across the workspaces died
# with `ECONNRESET` in CI, failing the run. npm's default retry budget is 2
# attempts with a 10s initial backoff, which is not enough for a long download
# over a shared runner network — a single reset mid-stream aborts the job.
#
# These values raise the retry budget and the per-request timeout. They are
# harmless locally (retries only happen on failure) and are the fix that makes
# the *first* run after a lockfile change — the one run guaranteed to have a
# cold cache — survive a transient network blip.
#
# Note: CI sets the equivalent `npm_config_*` environment variables in each
# workflow, because npm resolves project config from the `--prefix` directory
# and therefore would not read this file for `npm ci --prefix apps/web`.
# Keeping both means local installs in this workspace are resilient too, and the
# Docker build picks this file up via an explicit COPY (see the Dockerfile).

fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
