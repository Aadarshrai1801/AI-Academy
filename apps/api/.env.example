# Copy to .env and fill in
PORT=4000
CORS_ORIGINS=http://localhost:3000
WEBAPP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/hoopr
# Production: mongodb+srv://user:pass@cluster.mongodb.net/hoopr
REDIS_URL=redis://localhost:6379
CLERK_SECRET_KEY=sk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# ── Phase 2: AI question generation (Groq free tier, OpenAI-compatible) ──
# Get key at https://console.groq.com (no card, starts gsk_...). Model e.g. openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Rotation multiplies free-tier throughput (limits are per-model). Comma-separated fallback order.
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b
# Bank buffer target per (topic × difficulty) — spec §2.1 suggests ≥500
GENERATION_BUFFER_TARGET=400
GENERATION_BATCH_SIZE=10
GENERATION_CONCURRENCY=2
GENERATION_DAILY_BUDGET=10000
GENERATION_SIMILARITY_THRESHOLD=0.85
# Run the BullMQ worker inside the API process (set false when using `node dist/worker`)
GENERATION_WORKER=true
# ── Phase 3: realtime chat (leave empty for API + 3s polling fallback) ──
# Get one free at https://ably.com — paste the full app key (xxxx:yyyy)
ABLY_API_KEY=
# ── Phase 4: AI Q&A (leave empty for stub answers + no YouTube) ──
YOUTUBE_API_KEY=
AI_SIMILARITY_THRESHOLD=0.92
AI_YOUTUBE_CACHE_DAYS=7
# ── Phase 5: explainer videos (local ffmpeg render; keys unlock TTS/R2 later) ──
VIDEO_MONTHLY_BUDGET=200
VIDEO_COST_USD=0.02
VIDEO_WORKER=true
VIDEO_SECRET=change-me-in-production
# Voiced narration for explainer videos (leave empty for silent slideshows).
# Key: https://elevenlabs.io → profile → API keys (free tier ~10k chars/mo).
ELEVENLABS_API_KEY=
# Voice + model (defaults work; change for a different narrator voice).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hoopr-videos
R2_REGION=auto
# Public playback base (custom domain or r2.dev). When set, videoUrl is a
# direct https URL and the API 302-redirects signed file URLs to it.
# Leave empty for private-bucket mode (API mints 10-min presigned URLs).
# Remember to add a CORS rule on the bucket allowing GET from your web origin.
R2_PUBLIC_BASE_URL=
# Optional overrides (Linux cloud defaults to DejaVu; Windows dev uses Arial)
#VIDEO_TITLE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
#VIDEO_BODY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
#TTS_CACHE_DIR=
# ── Phase 6: video calls (Cloudflare RealtimeKit) ──
RTK_ACCOUNT_ID=
RTK_APP_ID=
RTK_API_TOKEN=
# Presets auto-created with dashboard apps; host for initiator/admin, participant for others
RTK_PRESET_HOST=group_call_host
RTK_PRESET_NAME=group_call_participant
CALL_MAX_GROUP_SIZE=10
CALL_PRO_MAX_MINUTES=240
CALL_WORKER=true
SENTRY_DSN=
