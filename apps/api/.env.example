# Copy to .env and fill in
# NODE_ENV=production turns on strict config validation: the API refuses to
# boot without MONGODB_URI, CLERK_SECRET_KEY, REDIS_URL, VIDEO_SECRET and
# (CORS_ORIGINS or WEBAPP_URL). Leave NODE_ENV unset for local dev.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
WEBAPP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/aiacademy
# Production: `mongodb+srv://user:pass@cluster.mongodb.net/aiacademy`
# Metered Redis (Upstash free tier) can be exhausted by BullMQ polling:
#   flat-rate Redis or a separate worker process is recommended —
#   see `docs/OPERATIONS.md` § Metered Redis.
REDIS_URL=redis://localhost:6379
# BullMQ idle-cost tuning (matters on metered Redis). Guard on by default:
# REDIS_COMMAND_BUDGET_GUARD=false restores BullMQ's own defaults.
#REDIS_COMMAND_BUDGET_GUARD=true
#REDIS_STALLED_INTERVAL_MS=120000
#REDIS_DRAIN_DELAY_S=30
# Express "trust proxy" setting: number of proxy hops in front of the API
# (default 1). Behind two hops (e.g. CDN + load balancer) set 2, otherwise
# per-IP rate limiting collapses every client onto the outermost proxy IP.
# Accepts any Express trust string too (e.g. "loopback" or CIDR list).
#TRUST_PROXY=1
# Rate-limit degradation when Redis is unreachable: fail closed (503) by
# default in production. In dev/test the default is the in-memory fallback.
#THROTTLE_FAIL_CLOSED=
# Requests per minute per user/IP (default 120).
#RATE_LIMIT_PER_MIN=120
# Set LEADERBOARD_WORKER=false to host the snapshot scheduler elsewhere (the
# nightly snapshot runs as a BullMQ job scheduler; BullMQ delivers to exactly
# one worker regardless of replica count).
#LEADERBOARD_WORKER=true
# Set LEADERBOARD_SNAPSHOT=false to disable the nightly snapshot scheduler.
#LEADERBOARD_SNAPSHOT=true
CLERK_SECRET_KEY=sk_test_...
# Dev-only auth passthrough when CLERK_SECRET_KEY is unset. Ignored in production.
ALLOW_DEV_AUTH_BYPASS=true
# Quota degradation when Redis is down. Defaults: allow in dev, deny (503) in production.
#QUOTA_FAIL_OPEN=false
# Retention purges (POST /admin/retention/purge-*): grace window in days before
# soft-deleted groups/messages are hard-deleted. Default 30.
#RETENTION_SOFT_DELETE_GRACE_DAYS=30
# Audit-trail TTL in days (0/off by default: audit events are kept indefinitely).
#AUDIT_RETENTION_DAYS=0
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# ── Phase 2: AI question generation (Groq free tier, OpenAI-compatible) ──
# Get key at https://console.groq.com (no card, starts gsk_...). Model e.g. openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Rotation multiplies free-tier throughput (limits are per-model). Comma-separated fallback order.
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b
# Bank buffer target per (topic × difficulty) — spec §2.1 suggests ≥500
GENERATION_BUFFER_TARGET=400
GENERATION_BATCH_SIZE=10
GENERATION_CONCURRENCY=2
GENERATION_DAILY_BUDGET=10000
GENERATION_SIMILARITY_THRESHOLD=0.85
# Run the BullMQ worker inside the API process (set false when using `node dist/worker`)
GENERATION_WORKER=true
# ── Phase 3: realtime chat (leave empty for API + 3s polling fallback) ──
# Get one free at https://ably.com — paste the full app key (xxxx:yyyy)
ABLY_API_KEY=
# ── Phase 4: AI Q&A (leave empty for stub answers + no YouTube) ──
YOUTUBE_API_KEY=
AI_SIMILARITY_THRESHOLD=0.92
AI_YOUTUBE_CACHE_DAYS=7
# ── Learning path: topic gating (Phase 8) ──
# Mastery gate: a topic unlocks when every prerequisite has this many
# consecutive first-try correct answers (hints/retries break the run).
# Set TOPIC_GATE_ENABLED=false to serve every topic to everyone (legacy mode).
#TOPIC_GATE_ENABLED=true
#TOPIC_GATE_CONSECUTIVE_CORRECT=3
# Adaptive mastery (per-user per-topic score 0-100; read with time decay).
# EMA per graded attempt (0.05-0.6, default 0.2) and review half-life in days.
#MASTERY_EMA_ALPHA=0.2
#MASTERY_DECAY_HALF_LIFE_DAYS=30
# Adaptive difficulty: with no explicit difficulty filter, /questions/next
# serves each unlocked topic near the learner's mastery band (free tier is
# capped at medium so the hard teaser keeps its meaning). false = legacy.
#ADAPTIVE_DIFFICULTY=true
# ── Phase 5: explainer videos (local ffmpeg render; keys unlock TTS/R2 later) ──
VIDEO_MONTHLY_BUDGET=200
VIDEO_COST_USD=0.02
VIDEO_WORKER=true
VIDEO_SECRET=change-me-in-production
# Generate a strong value: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Production without VIDEO_SECRET refuses to boot (signed playback URLs would be forgeable).
# Voiced narration for explainer videos (leave empty for silent slideshows).
# Key: https://elevenlabs.io → profile → API keys (free tier ~10k chars/mo).
ELEVENLABS_API_KEY=
# Voice + model (defaults work; change for a different narrator voice).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-academy-videos
R2_REGION=auto
# Public playback base (custom domain or r2.dev). When set, videoUrl is a
# direct https URL and the API 302-redirects signed file URLs to it.
# Leave empty for private-bucket mode (API mints 10-min presigned URLs).
# Remember to add a CORS rule on the bucket allowing GET from your web origin.
R2_PUBLIC_BASE_URL=
# Optional overrides (Linux cloud defaults to DejaVu; Windows dev uses Arial)
#VIDEO_TITLE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
#VIDEO_BODY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
#TTS_CACHE_DIR=
# Absolute path to the ffmpeg binary when it is not on PATH (default: ffmpeg).
#FFMPEG_PATH=/usr/bin/ffmpeg
# ── Phase 6: video calls (Cloudflare RealtimeKit) ──
RTK_ACCOUNT_ID=
RTK_APP_ID=
RTK_API_TOKEN=
# Presets auto-created with dashboard apps; host for initiator/admin, participant for others
RTK_PRESET_HOST=group_call_host
RTK_PRESET_NAME=group_call_participant
# Legacy alias still read as a fallback for RTK_PRESET_NAME.
#RTK_PRESET_PARTICIPANT=group_call_participant
CALL_MAX_GROUP_SIZE=10
CALL_PRO_MAX_MINUTES=240
CALL_WORKER=true
# ── Keep-alive (Render free tier sleeps after ~15 min idle) ──
# Zero-config on Render (RENDER_EXTERNAL_URL is auto-injected). The GitHub
# Action .github/workflows/keepalive.yml is the real wake-up call — this
# in-process pinger is the second layer. Set false to disable.
#KEEPALIVE_ENABLED=true
#KEEPALIVE_URL=https://ai-academy-api-xxxx.onrender.com
#KEEPALIVE_INTERVAL_MS=600000
SENTRY_DSN=
# Optional: performance sampling (default 0.1). Set 0 to disable tracing.
#SENTRY_TRACES_SAMPLE_RATE=0.1
# ── Metrics (GET /metrics, Prometheus text format) ──
# Set a token to require `Authorization: Bearer <token>` on scrapes. Leave
# empty only when the scraper is network-isolated from the public internet.
#METRICS_TOKEN=
# Optional: release/commit shown in /health and Sentry (Render sets RENDER_GIT_COMMIT).
#GIT_COMMIT=
# ── CLI script guards (never required for the API itself) ────────────────
# `npm run promote` refuses in production unless CONFIRM_PROMOTE=<clerkId>.
#CONFIRM_PROMOTE=
# `npm run seed` refuses any non-local MONGODB_URI (or NODE_ENV=production)
# unless CONFIRM_SEED=yes.
#CONFIRM_SEED=
